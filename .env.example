# MySQL (local Docker Compose instance — see docker-compose.yml)
MYSQL_ROOT_PASSWORD="change-me"
MYSQL_DATABASE="entaj"
MYSQL_USER="entaj"
MYSQL_PASSWORD="change-me"
DB_PORT="3306"
DATABASE_URL="mysql://entaj:change-me@localhost:3306/entaj"

# Initial admin account (created by database/seed.ts — never hardcoded, never commit real values)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# JWT auth
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Resend (transactional email) — currently unused; SMTP below is the active mail path
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# SMTP (cPanel mail server)
SMTP_HOST="mail.entaj.co"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="info@entaj.co"
SMTP_PASSWORD=""
CONTACT_NOTIFICATION_EMAIL="info@entaj.co"
EMAIL_FROM="ENTAJ <info@entaj.co>"

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Local storage (see storage/ at project root, served via /api/storage)
STORAGE_ROOT="storage"
STORAGE_MAX_UPLOAD_MB="5"
