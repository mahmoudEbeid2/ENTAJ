# MySQL (local Docker Compose instance — see docker-compose.yml)
MYSQL_ROOT_PASSWORD="change-me"
MYSQL_DATABASE="entaj"
MYSQL_USER="entaj"
MYSQL_PASSWORD="change-me"
DB_PORT="3306"
DATABASE_URL="mysql://entaj:change-me@localhost:3306/entaj"

# Initial admin account (created by database/seed.ts — never hardcoded, never commit real values)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# JWT auth
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Server Actions encryption key. Without this, Next.js generates a random key
# on every `next build` and stores it under .next/cache/ — but
# docker/entrypoint.sh always builds into a fresh directory (see its atomic
# .next.building rename), so that cache never persists and every redeploy
# gets a brand new key. Any admin tab left open from before the redeploy then
# gets "Server Action was not found on the server" on its next submit, since
# the action IDs it has were signed with the old key. Pinning this value keeps
# it stable across builds so open tabs keep working after a deploy. Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace-with-a-generated-base64-key"

# Resend (transactional email) — currently unused; SMTP below is the active mail path
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# SMTP (cPanel mail server)
SMTP_HOST="mail.entaj.co"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="info@entaj.co"
SMTP_PASSWORD=""
CONTACT_NOTIFICATION_EMAIL="info@entaj.co"
EMAIL_FROM="ENTAJ <info@entaj.co>"

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Traefik / Let's Encrypt (production only — see docker-compose.prod.yml)
ACME_EMAIL="admin@entaj.co"

# Local storage (see storage/ at project root, served via /api/storage)
STORAGE_ROOT="storage"
STORAGE_MAX_UPLOAD_MB="5"
